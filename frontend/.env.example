# 本地开发：复制为 .env.development（勿提交真实密钥；前端通常无密钥）
VITE_API_BASE=/api

# 后端未就绪、仅看 UI 时取消下一行注释：
# VITE_USE_MOCK=true

# 画像 / 路径智能体默认走后端（设 =0 可切回本地引导）
# VITE_PROFILE_BUILD_API=0
# VITE_PATH_PLAN_API=0

# 强制 Mock（可选）
# VITE_AGENT_CHAT_MOCK=1
# VITE_GUEST_CHAT_MOCK=1

# 头像静态源：默认相对路径 /static（Vite 代理或 Nginx 同源即可）
# 仅当需直连 user-service 时取消注释：
# VITE_STATIC_ORIGIN=http://127.0.0.1:8001
