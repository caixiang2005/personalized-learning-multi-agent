# 复制为 .env.development 或 .env.local 使用
VITE_API_BASE=/api

# 开发代理（vite.config.ts，无需写在 env 里）：
#   /api/user/*  → user-service  http://127.0.0.1:8001
#   /api/agent/* → agent-service http://127.0.0.1:8003

# 设为 true 时不请求 user-service，验证码/密码 Mock：123456
# VITE_USE_MOCK=true

# 设为 1 时强制使用本地 Mock，不请求 agent-service
# VITE_GUEST_CHAT_MOCK=1
