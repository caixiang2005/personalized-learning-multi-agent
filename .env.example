# ──────────────────────────────────
# 智慧学习中心 · 根环境变量
# 复制为 .env 后按需修改
# ──────────────────────────────────

# --- 服务端口 ---
USER_SERVICE_PORT=8001
LEARN_SERVICE_PORT=8002
AGENT_SERVICE_PORT=8003
FRONTEND_PORT=5174

# --- 数据库（PostgreSQL） ---
# 格式: postgresql+psycopg2://用户名:密码@主机:5432/数据库名
DATABASE_URL=postgresql+psycopg2://team_user:YOUR_DB_PASSWORD@8.153.204.117/project_db

# --- Redis ---
REDIS_HOST=8.153.204.117
REDIS_PORT=6379
REDIS_DB=0

# --- DeepSeek API（agent-service用） ---
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 服务间通信 ---
# learn-service 调用 agent-service 的地址
AGENT_SERVICE_URL=http://127.0.0.1:8003
# agent-service 调用 learn-service 的地址
LEARN_SERVICE_URL=http://127.0.0.1:8002
