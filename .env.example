# ──────────────────────────────────
# 智慧学习中心 · 根环境变量（模板）
# 复制为 .env 后填写真实值；.env 勿提交 / 勿随作品上交
# ──────────────────────────────────

# --- 服务端口 ---
USER_SERVICE_PORT=8001
LEARN_SERVICE_PORT=8002
AGENT_SERVICE_PORT=8003
FRONTEND_PORT=5173

# --- 数据库（PostgreSQL）---
# 格式: postgresql+psycopg2://用户名:密码@主机:5432/数据库名
DATABASE_URL=postgresql+psycopg2://your_db_user:your_db_password@127.0.0.1:5432/project_db

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- DeepSeek API（agent-service）---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 服务间通信 ---
AGENT_SERVICE_URL=http://127.0.0.1:8003
LEARN_SERVICE_URL=http://127.0.0.1:8002
