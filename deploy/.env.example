# Copy to .env - do NOT commit real secrets
HTTP_PORT=80
N8N_PORT=5678
N8N_HOST=0.0.0.0
# Public URL for n8n webhooks (set to ECS public IP/domain)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
DIFY_PORT=8080

# Aliyun RDS PostgreSQL (or teammate cloud DB)
DATABASE_URL=postgresql+psycopg2://team_user:PASSWORD@RDS_HOST:5432/project_db
PG_HOST=RDS_HOST
PG_PORT=5432
PG_USER=team_user
PG_PASSWORD=PASSWORD
PG_DATABASE=project_db

# DeepSeek (required)
DEEPSEEK_API_KEY=sk-YOUR_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

HF_ENDPOINT=https://hf-mirror.com

# SMTP: edit backend/user-service/config/settings.yaml
# Compose sets REDIS_HOST=redis for all app services
