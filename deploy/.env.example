# 复制为 deploy/.env 后填写；.env 勿提交 / 勿随作品上交
HTTP_PORT=80
N8N_PORT=5678
N8N_HOST=0.0.0.0
# 公网访问时改为 http://<ECS公网IP>:5678/
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
DIFY_PORT=8080

# PostgreSQL（阿里云 RDS 或自建）
DATABASE_URL=postgresql+psycopg2://your_db_user:your_db_password@RDS_HOST:5432/project_db
PG_HOST=RDS_HOST
PG_PORT=5432
PG_USER=your_db_user
PG_PASSWORD=your_db_password
PG_DATABASE=project_db

# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

HF_ENDPOINT=https://hf-mirror.com

# 邮件验证码：复制 backend/user-service/config/settings.example.yaml
#   → settings.yaml 后填写 SMTP（settings.yaml 勿上交）
# Compose 会为各服务设置 REDIS_HOST=redis
