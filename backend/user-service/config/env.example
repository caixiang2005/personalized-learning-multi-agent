# 复制为 config/.env；与 Navicat 连接一致（密码含 @ 需写成 %40）

# project_db 库中的 users 表（服务不会自动建表）
DATABASE_URL=postgresql+psycopg2://team_user:YOUR_DB_PASSWORD@8.153.204.117/project_db

# Redis（验证码缓存用）
REDIS_HOST=8.153.204.117

# SMTP（发送验证码邮件用，QQ 邮箱需开启 SMTP 服务后使用授权码）
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SENDER=你的QQ邮箱@qq.com
MAIL_AUTH_CODE=你的QQ邮箱授权码
