# 复制为 .env 后填写；.env 勿提交 / 勿随作品上交

# 高德地图（可选，天气等）
AMAP_API_KEY=your_amap_api_key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Redis 会话
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL（错误日志 / 向量库等）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=your_db_user
PG_PASSWORD=your_db_password
PG_DATABASE=project_db

# HuggingFace 镜像（国内可保持默认）
HF_ENDPOINT=https://hf-mirror.com

# 可选：本地 embedding 模型目录（下载后填写可离线）
# EMBED_MODEL_PATH=./models/bge-small-zh-v1.5
# PRELOAD_EMBEDDING=1
# PRELOAD_CNOCR=1

# 调用 learn-service（Docker 内用服务名）
LEARN_SERVICE_URL=http://127.0.0.1:8002
