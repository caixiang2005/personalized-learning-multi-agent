# 高德地图 API 配置（天气查询等）
AMAP_API_KEY=你的高德API密钥

# Deepseek API 配置（如有需要可更换成其他兼容 OpenAI 的 API，修改 .env 值即可）
DEEPSEEK_API_KEY=sk-你的API密钥
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Redis 会话存储
REDIS_HOST=你的Redis服务器地址
REDIS_PORT=6379
REDIS_DB=0

# PostgreSQL 错误日志（n8n 从这里拉取错误信息）
PG_HOST=你的PostgreSQL服务器地址
PG_PORT=5432
PG_USER=数据库用户名
PG_PASSWORD=数据库密码
PG_DATABASE=数据库名称
