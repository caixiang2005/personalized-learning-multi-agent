# 虚拟环境
venv/
.venv/

# Python 缓存与测试产物
__pycache__/
*.pyc
*.pyo
*.py[cod]
.pytest_cache/
*.egg-info/

# Node 依赖与前端构建
node_modules/
dist/
dist-ssr/

# 环境密钥 / 隐私配置（仅忽略真实文件；*.example / env.example 模板可提交上交）
.env
.env.local
.env.development
.env.production
.env.*.local
# user-service 真实 SMTP 等（模板为 settings.example.yaml）
backend/user-service/config/settings.yaml

# Cursor IDE 本地配置 / Agent Skills（勿提交仓库）
.cursor/

# 编辑器
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db


# 知识库爬取内容（运行脚本自动生成，不上传原始数据）
knowledge/

# 临时与备份
*.bak
*.swp
*~

# 日志
logs/
*.log

# user-service 静态资源：演示头像等图片需要随作品上传
# 仅忽略明显的本地临时文件；avatar 下 png/jpg/webp/gif 可提交
backend/user-service/static/**/*.tmp
backend/user-service/static/**/*~

# github 目录（workflow 若已跟踪则保持；新文件默认忽略）
.github/

# 忽略.claude配置文件
.claude/

# 临时文件
*.tmp
*.temp

# 开发调试脚本（根目录级别，避免误提交）
/_*.ps1
/_*.py
deploy/.env
deploy/dify-src/
deploy/compose-run.log

# 打包上传临时包（勿上交）
plma-upload.tar

