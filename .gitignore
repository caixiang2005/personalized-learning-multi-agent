# 虚拟环境
venv/
.venv/

# Python 缓存与测试产物
__pycache__/
*.pyc
*.pyo
*.py[cod]
.pytest_cache/
*.egg-info/

# Node 依赖与前端构建
node_modules/
dist/
dist-ssr/

# 环境密钥（仅忽略真实配置；*.example 模板可提交）
.env
.env.local
.env.development
.env.production
.env.*.local

# Cursor IDE 本地配置 / Agent Skills（勿提交仓库）
.cursor/

# 编辑器
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db


# 知识库爬取内容（运行脚本自动生成，不上传原始数据）
knowledge/

# 临时与备份
*.bak
*.swp
*~

# 日志
logs/
*.log

# user-service 用户上传静态资源（头像等）
backend/user-service/static/

# github 目录（workflow 若已跟踪则保持；新文件默认忽略）
.github/
